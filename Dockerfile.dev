# Dev container for Inkwing.
#
# Why a container: Tauri 2 needs libwebkit2gtk-4.1 / libsoup-3.0 etc. that
# Ubuntu 20.04 (the host) does not ship. Jammy has them all.
#
# Why Xvfb + noVNC: the host is a headless remote (no DISPLAY). The container
# carries its own X server + a websocket VNC bridge so the Tauri window can
# be viewed in any browser at http://<host>:6080/vnc.html.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# ---- system deps -----------------------------------------------------------
# Tauri 2 build/runtime + dev tooling + virtual display + window manager + VNC.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl wget git ca-certificates file sudo gnupg \
      libssl-dev \
      libdbus-1-dev \
      libgtk-3-dev \
      libwebkit2gtk-4.1-dev \
      libsoup-3.0-dev \
      libjavascriptcoregtk-4.1-dev \
      librsvg2-dev \
      libxdo-dev \
      libayatana-appindicator3-dev \
      iproute2 iptables iputils-ping dnsutils \
      xvfb x11-utils x11-xserver-utils \
      fluxbox xterm \
      x11vnc novnc websockify \
      python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Node 24 (NodeSource) — avoids NVM PATH gymnastics in CMD.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10

# ---- non-root user with host-matching UID/GID ------------------------------
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN if getent group ${GROUP_ID} >/dev/null; then \
        groupmod -n dev "$(getent group ${GROUP_ID} | cut -d: -f1)"; \
    else \
        groupadd -g ${GROUP_ID} dev; \
    fi \
    && if getent passwd ${USER_ID} >/dev/null; then \
        usermod -l dev -d /home/dev -m "$(getent passwd ${USER_ID} | cut -d: -f1)"; \
    else \
        useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash dev; \
    fi \
    && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev \
    && chmod 440 /etc/sudoers.d/dev

USER dev
WORKDIR /home/dev

# ---- Rust via rustup -------------------------------------------------------
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.88.0 --profile minimal --no-modify-path
ENV PATH="/home/dev/.cargo/bin:${PATH}" \
    CARGO_HOME=/home/dev/.cargo \
    RUSTUP_HOME=/home/dev/.rustup

# ---- entrypoint ------------------------------------------------------------
COPY --chown=dev:dev scripts/container-entrypoint.sh /home/dev/entrypoint.sh
RUN chmod +x /home/dev/entrypoint.sh

WORKDIR /workspace

EXPOSE 1420 6080

# compose's `init: true` provides a PID-1 init (docker-init / Tini); we just
# run our entrypoint as a normal script.
ENTRYPOINT ["/home/dev/entrypoint.sh"]
CMD ["sleep", "infinity"]
