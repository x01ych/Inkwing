# Logs
*.log

# Local-only settings
.env
.env.local

# Real, user-supplied sing-box configs used for local dev / regression
# tests only — NEVER commit (likely contains live server credentials).
configs-local/

# Runtime artefacts written by sing-box when it runs from the project
# CWD (regression test, dev container). cache.db holds rule-set cache
# + URL-test latency history (potentially sensitive). /ui is the
# external dashboard sing-box auto-downloads at the repo root — anchor
# with a leading slash so it doesn't shadow src/components/ui/ (shadcn).
/cache.db
/ui/

# Docker volumes (managed by docker; nothing to ignore in workspace)

